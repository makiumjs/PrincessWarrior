[rendering]

renderer/rendering_method="forward_plus"

; Main.tscn has no WorldEnvironment, so the viewport was clearing to Godot's
; default mid grey. Measured on a capture at room start: the leftmost column
; was flat grey on 60 of 81 sampled rows, against 4-12 in the middle of the
; screen. The parallax layers sit at y=4.0 and y=7.4 and cannot cover the
; bottom of the frame, and no backdrop can cover every camera position, so the
; clear colour is the right place to fix it rather than more geometry.
environment/defaults/default_clear_color=Color(0.055, 0.06, 0.08, 1)
