; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are meant to be edited.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LostCrownlike"
run/main_scene="res://scenes/ui/Title.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/Core/EventBus.cs"
AudioManager="*res://src/Audio/AudioManager.cs"
SaveManager="*res://src/Save/SaveManager.cs"

[dotnet]

project/assembly_name="LostCrownlike"

