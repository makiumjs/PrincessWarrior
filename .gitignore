# Godot editor cache and reimport artifacts
game/.godot/
game/.mono/
game/android/

# .NET build output
**/bin/
**/obj/
*.user

# The engine binary: 258 MB, and downloadable from godotengine.org.
# tools/verify.sh expects it at this exact path.
tools/Godot_v4.7.2-stable_mono_win64/
tools/.engine-errors.log
tools/capture/

# Export output. export_presets.cfg itself IS committed: it is desktop-only
# configuration with no secrets in it, and it is the kind of file that is
# painful to lose and easy to forget. Revisit this if a signing keystore is
# ever added, which would put a password in it.
/build/
game/build/
game/exports/

# Raw CC0 asset downloads: 119 MB of packs and their zips. The imported
# copies the game actually loads are committed under game/assets.
assets_src/

# Playtest frame dumps: 35 MB of PNGs regenerated by the capture runner.
game/docs/critic-captures/

# Throwaway patch scripts. They exist for one edit and are deleted after;
# one slipped into a commit before this line did.
game/_*.py

# Temporary scratch & API dumps
Claude outputs/
extension_api.json
/*.jpg
